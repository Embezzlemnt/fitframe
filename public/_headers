/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https:; media-src 'self' blob:; connect-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://docs.opencv.org https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-store
