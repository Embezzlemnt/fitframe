{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fitframe",
  "compatibility_date": "2026-05-08",
  "main": "./worker/index.js",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
